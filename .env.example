# Copy to .env and adjust. docker compose picks it up automatically.
POSTGRES_USER=tessera
POSTGRES_PASSWORD=tessera
RABBITMQ_USER=tessera
RABBITMQ_PASSWORD=tessera
# At least 32 characters. Shared by the token issuer (Wallet.Api) and all resource servers.
JWT_SIGNING_KEY=replace-me-with-a-long-random-secret-0123456789
