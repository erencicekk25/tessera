{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "tessera-identity",
    "Audience": "tessera-clients",
    "SigningKey": "dev-only-signing-key-change-me-0123456789abcdef"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:8080" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "wallet",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth-throttle",
        "Match": { "Path": "/api/auth/{**rest}" }
      },
      "wallet": {
        "ClusterId": "wallet",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/wallet/{**rest}" }
      },
      "scores": {
        "ClusterId": "scoring",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/api/scores/{**rest}" }
      },
      "score-hub": {
        "ClusterId": "scoring",
        "AuthorizationPolicy": "authenticated",
        "Match": { "Path": "/hubs/{**rest}" }
      }
    },
    "Clusters": {
      "wallet": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5101" }
        }
      },
      "scoring": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5102" }
        }
      }
    }
  }
}
